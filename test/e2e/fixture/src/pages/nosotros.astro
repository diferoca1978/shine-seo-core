---
import Layout from '../layouts/Layout.astro';
import { PAGES } from '../config/pages';
import { seo } from '../config/seo';
const page = PAGES.nosotros;
const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Nosotros', path: page.path }];
---

<Layout head={seo.pageHead(page)} schemas={[seo.businessRef(), seo.breadcrumbNode(crumbs)]}>
  <nav aria-label="Migas"><a href="/">Inicio</a> › Nosotros</nav>
  <h1>{page.h1}</h1>
</Layout>
